{
  "openapi": "3.0.3",
  "info": {
    "title": "Canjean Exchange Rate API",
    "version": "1.0.0",
    "description": "Free exchange rate API with no API key. Daily reference rates for 150+ currencies (plus BTC) in JSON, CSV or plain text, ready for Google Sheets (IMPORTDATA) and Excel (WEBSERVICE). Data from a public-domain (CC0) dataset compiled from central banks and markets. Limit: 120 requests per minute per IP. Please credit Canjean with a link.",
    "contact": {
      "name": "Canjean",
      "url": "https://canjean.com/exchange-rate-api",
      "email": "contact@canjean.com"
    },
    "termsOfService": "https://canjean.com/exchange-rate-api",
    "x-logo": {
      "url": "https://canjean.com/assets/img/icon-512.png"
    }
  },
  "externalDocs": {
    "description": "Documentation and spreadsheet examples",
    "url": "https://canjean.com/exchange-rate-api"
  },
  "servers": [
    {
      "url": "https://canjean.com/api"
    }
  ],
  "paths": {
    "/rate/{from}/{to}.txt": {
      "get": {
        "summary": "Exchange rate as plain text",
        "operationId": "getRateText",
        "parameters": [
          {
            "name": "from",
            "in": "path",
            "required": true,
            "description": "Base currency (ISO 4217)",
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z]{3}$",
              "example": "USD"
            }
          },
          {
            "name": "to",
            "in": "path",
            "required": true,
            "description": "Target currency (ISO 4217)",
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z]{3}$",
              "example": "EUR"
            }
          },
          {
            "name": "decimal",
            "in": "query",
            "required": false,
            "description": "Use `comma` to get a decimal comma in plain-text responses (spreadsheets in many European locales).",
            "schema": {
              "type": "string",
              "enum": [
                "comma"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Rate as a number",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string",
                  "example": "0.888026"
                }
              }
            }
          },
          "404": {
            "description": "Unknown currency or endpoint",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              },
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded (120 requests per minute per IP)"
          }
        }
      }
    },
    "/rate/{from}/{to}.json": {
